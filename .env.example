# Copia questo file in .env.local e compila i valori. .env.local non va mai committato.

# Connection string Neon Postgres (dashboard Neon → Connect → copia la stringa, con ?sslmode=require)
DATABASE_URL=

# Segreto per Auth.js: generalo con `npx auth secret` oppure `openssl rand -base64 32`
AUTH_SECRET=

# Solo per `npm run start` in locale (su Vercel non serve)
# AUTH_TRUST_HOST=true
